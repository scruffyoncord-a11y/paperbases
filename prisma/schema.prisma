generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String?
  name      String?
  picture   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  progress  Progress[]
  doubts    Doubt[]
  replies   Reply[]
  resources Resource[]
  resourceLikes ResourceLike[]
}

model Resource {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  subject     String   // e.g. "Physics", "Chemistry"
  tag         String?  // e.g. "PYQ", "Formula Sheet"
  fileUrl     String
  fileType    String   // e.g. "pdf", "image"
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes       ResourceLike[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ResourceLike {
  id         Int      @id @default(autoincrement())
  resourceId Int
  userId     Int
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId])
}

model Progress {
  id           Int      @id @default(autoincrement())
  userId       Int
  subject      String   // e.g. "Maths", "Physics"
  chapterIndex Int      // 0-based index
  status       Int      @default(0) // 0: untouched, 1: skipped, 2: learning, 3: mastered
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subject, chapterIndex])
}

model Doubt {
  id        Int      @id @default(autoincrement())
  userId    Int
  subject   String
  title     String
  content   String
  imageUrl  String?  // New field for media uploads
  status    String   @default("Unanswered") // Unanswered, Resolved
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   Reply[]
}

model Reply {
  id        Int      @id @default(autoincrement())
  doubtId   Int
  userId    Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doubt     Doubt    @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
