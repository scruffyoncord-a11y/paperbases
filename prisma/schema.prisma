generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  password  String?
  name      String?
  picture   String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  streak    Int        @default(0)
  focusTime Int        @default(0) // minutes
  points    Int        @default(0) // gamification points for resources
  policiesAccepted Boolean @default(false)
  progress  Progress[]
  doubts    Doubt[]
  replies   Reply[]
  resources Resource[]
  resourceLikes ResourceLike[]
  tasks       Task[]
  schedules   ScheduleSlot[]
  highlights  Highlight[]
  chats       Chat[]
  messages    Message[]
}

model Resource {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  subject     String   // e.g. "Physics", "Chemistry"
  tag         String?  // e.g. "PYQ", "Formula Sheet"
  fileUrl     String
  fileType    String   // e.g. "pdf", "image"
  textContent String?  @db.Text // Cached extracted PDF text for PaperAI
  userId      Int
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes       ResourceLike[]
  highlights  Highlight[]
  chats       Chat[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([subject])
  @@index([createdAt])
  @@index([userId])
}

model ResourceLike {
  id         Int      @id @default(autoincrement())
  resourceId Int
  userId     Int
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([resourceId, userId])
}

model Task {
  id        Int      @id @default(autoincrement())
  userId    Int
  title     String
  subject   String
  color     String?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScheduleSlot {
  id        Int      @id @default(autoincrement())
  userId    Int
  day       String   // e.g., "Mon", "Tue"
  time      String   // e.g., "08:00 AM"
  title     String   
  type      String   // "Study", "Practice", "Exam"
  duration  String   // e.g., "2h"
  theme     String   // e.g., "blue", "orange"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Progress {
  id           Int      @id @default(autoincrement())
  userId       Int
  subject      String   // e.g. "Maths", "Physics"
  chapterIndex Int      // 0-based index
  status       Int      @default(0) // 0: untouched, 1: skipped, 2: learning, 3: mastered
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subject, chapterIndex])
}

model Doubt {
  id        Int      @id @default(autoincrement())
  userId    Int
  subject   String
  title     String
  content   String
  imageUrl  String?  // New field for media uploads
  status    String   @default("Unanswered") // Unanswered, Resolved
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies   Reply[]

  @@index([subject])
  @@index([createdAt])
  @@index([userId])
}

model Reply {
  id        Int      @id @default(autoincrement())
  doubtId   Int
  userId    Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  doubt     Doubt    @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Highlight {
  id         Int      @id @default(autoincrement())
  userId     Int
  resourceId Int
  text       String?  @db.Text
  pageIndex  Int      @default(0)
  color      String?  @default("yellow")
  position   Json?
  content    Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([resourceId])
}

model Chat {
  id         Int       @id @default(autoincrement())
  userId     Int
  resourceId Int
  title      String?   // Auto-generated from first message
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource   Resource  @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  messages   Message[]

  @@index([userId, resourceId])
}

model Message {
  id        Int      @id @default(autoincrement())
  chatId    Int
  userId    Int
  role      String   // "user" or "assistant"
  content   String   @db.Text
  createdAt DateTime @default(now())
  chat      Chat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([chatId])
}
